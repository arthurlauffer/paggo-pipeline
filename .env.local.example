# =============================================================================
# Paggo Pipeline — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores.
# No Vercel, adicione estas variáveis em Project → Settings → Environment Variables.
# =============================================================================

# ── Banco de dados (obrigatório) ──────────────────────────────────────────────
# Obtenha a connection string no painel da Neon (neon.tech) ou Supabase:
#   Neon:     Dashboard → Connection string → Pooled connection
#   Supabase: Project Settings → Database → Connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── URL pública do app (para OAuth callbacks) ─────────────────────────────────
# Em desenvolvimento: http://localhost:3000
# Em produção: https://seu-app.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Google Calendar (opcional) ────────────────────────────────────────────────
# Crie um projeto em console.cloud.google.com e habilite a Calendar API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── IA (opcional) ────────────────────────────────────────────────────────────
# Para o assistente Ask Paggo CRM
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# ── CSV path (opcional, para seed local) ──────────────────────────────────────
# Caminho absoluto para o deals.csv se não estiver em data/deals.csv
# CSV_PATH=/caminho/para/deals.csv
